{
  "name": "Codex CLI",
  "kind": "terminal",
  "startCommand": "codex",
  "description": "OpenAI Codex 命令行（已随安装包内置，无需全局安装）：选中后主区整屏终端直接运行",
  "envVars": [
    {
      "key": "CODEX_HOME",
      "label": "Codex 配置目录",
      "defaultPath": "~/.codex",
      "description": "留空即用 ~/.codex"
    }
  ]
}
